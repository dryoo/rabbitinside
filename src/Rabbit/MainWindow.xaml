<Window x:Class="Rabbit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rabbit"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="rabbit inside" Height="520" Width="880"
        MinWidth="560" MinHeight="360"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 정렬과 타일 크기를 아이콘 버튼으로 보여주기 위한 스타일 -->
        <Style x:Key="IconToggle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TileSelected}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TileSelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 무료 게임 줄에서 쓰는 링크 모양 단추입니다. -->
        <Style x:Key="BannerLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="4,2">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       TextDecorations="Underline" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource TileHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 무료 게임 줄을 닫는 X 단추입니다. -->
        <Style x:Key="BannerCloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource TileHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 설정처럼 아이콘만 두는 단추입니다. 정렬 아이콘과 같은 크기로 맞춥니다. -->
        <Style x:Key="ToolIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource TileHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonRoot"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonRoot"
                                        Property="Background"
                                        Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonRoot"
                                        Property="Background"
                                        Value="{DynamicResource TileSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButton"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonRoot"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonRoot"
                                        Property="Background" Value="#FFC42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonRoot"
                                        Property="Background" Value="#FF9E2117" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 메인 화면은 런처와 갤러리를 탭으로 나눕니다. 기본 탭의 밝은 테두리 대신 테마 색을 씁니다. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="TitleBarRoot"
                                    Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource Separator}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#x1F407;"
                                               ToolTip="rabbit inside"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="17"
                                               Margin="14,0,7,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform Y="-5" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TabPanel Grid.Column="1"
                                              IsItemsHost="True"
                                              Margin="0,0,142,0"
                                              VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background"
                                        Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background"
                                        Value="{DynamicResource TileSelected}" />
                                <Setter TargetName="TabRoot" Property="BorderBrush"
                                        Value="{DynamicResource TileSelectedBorder}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <TabControl x:Name="MainTabs"
                SelectionChanged="MainTabs_AggregateSelectionChanged"
                MouseLeftButtonDown="MainTabs_MouseLeftButtonDown">
    <TabItem Header="런처">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ListBox x:Name="ShortcutList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     MouseDoubleClick="ShortcutList_MouseDoubleClick"
                     KeyDown="ShortcutList_KeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 칸 크기를 직접 정해 오른쪽에 빈 공간이 남지 않게 하고,
                             남는 세로 공간은 칸 높이와 위 여백으로 나눠 넣습니다. -->
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="{Binding TileItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                   ItemHeight="{Binding TileItemHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="{Binding TileAreaMargin, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TileRoot" Background="Transparent"
                                            BorderThickness="1" BorderBrush="Transparent"
                                            CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileRoot" Property="Background"
                                                    Value="{DynamicResource TileHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TileRoot" Property="Background"
                                                    Value="{DynamicResource TileSelected}" />
                                            <Setter TargetName="TileRoot" Property="BorderBrush"
                                                    Value="{DynamicResource TileSelectedBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTipService.InitialShowDelay="250">
                            <Grid.ToolTip>
                                <ToolTip Padding="8,6"
                                         DataContext="{Binding PlacementTarget.DataContext,
                                                               RelativeSource={RelativeSource Self}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SizeText}" Opacity="0.7" FontSize="11" />
                                        <TextBlock Text="{Binding MissingText}" Foreground="#FFE0A030" FontSize="11" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="10"
                                                   TextWrapping="Wrap" MaxWidth="420" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Grid>
                                <Image Source="{Binding Icon}"
                                       Width="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding TileIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="4"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="&#x1F4CC;"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           FontSize="12"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            </StackPanel>
                            <TextBlock Text="&#x26A0;" FontSize="13" Margin="2"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="#FFE0A030"
                                       Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="실행" Click="MenuLaunch_Click" />
                                    <MenuItem Header="고정" IsCheckable="True"
                                              IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                              Click="MenuPin_Click" />
                                    <MenuItem Header="이름 바꾸기" Click="MenuRename_Click" />
                                    <MenuItem Header="아이콘 직접 지정…" Click="MenuSetIcon_Click" />
                                    <MenuItem Header="아이콘 자동 선택으로 되돌리기" Click="MenuResetIcon_Click" />
                                    <MenuItem Header="대상 폴더 열기" Click="MenuOpenTargetFolder_Click" />
                                    <MenuItem Header="설치 용량 계산" Click="MenuComputeSize_Click" />
                                    <MenuItem Header="경로 복사" Click="MenuCopyPath_Click" />
                                    <Separator />
                                    <MenuItem Header="목록에서 제거" Click="MenuRemove_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <TextBlock x:Name="EmptyHint"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Opacity="0.45"
                           Visibility="Collapsed"
                           Text="바탕화면이나 탐색기·시작 메뉴에서 바로가기를&#x0a;이 창으로 끌어다 놓으세요" />
        </Grid>

        <!-- 지금 Epic에서 무료로 받을 수 있는 게임을 알려 주는 줄입니다.
             X를 누르면 이번 묶음은 닫히고, 다음 무료 게임이 나오면 다시 나타납니다. -->
        <Border x:Name="FreeGameBanner" Grid.Row="1" Margin="0,10,0,0" Padding="8,4,4,4"
                CornerRadius="6" Visibility="Collapsed"
                Background="{DynamicResource TileHover}"
                BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}">
            <DockPanel LastChildFill="False">
                <Button x:Name="FreeGameDismissButton" DockPanel.Dock="Right"
                        Style="{StaticResource BannerCloseButton}"
                        Content="&#x2715;" ToolTip="이번 무료 게임 알림 닫기"
                        Click="FreeGameDismiss_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BannerLinkButton}"
                        Margin="4,0,6,0" Content="전체 보기"
                        ToolTip="무료 게임 목록 열기" Click="OpenFreeGamesPage_Click" />

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,6,0"
                           FontFamily="Segoe UI Emoji" FontSize="13" Text="&#x1F381;" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Opacity="0.85" Text="Epic 무료 게임" />

                <StackPanel x:Name="FreeGameLinks" DockPanel.Dock="Left"
                            Orientation="Horizontal" VerticalAlignment="Center" />

                <TextBlock x:Name="FreeGameDeadline" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11" Opacity="0.6" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <!-- 평소에는 숨겨 두고, 키보드를 누르면 나타납니다. -->
            <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="260" Padding="5,4"
                     Visibility="Collapsed" VerticalAlignment="Center"
                     Background="{DynamicResource ControlBackground}"
                     Foreground="{DynamicResource WindowForeground}"
                     BorderBrush="{DynamicResource ControlBorder}"
                     CaretBrush="{DynamicResource WindowForeground}"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
            <TextBlock x:Name="SearchHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Opacity="0.5" FontSize="11" Text="아무 키나 누르면 검색 · ? 는 정보" />
            <TextBlock x:Name="MessageText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Opacity="0.7" FontSize="11" Visibility="Collapsed" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="12" Opacity="0.7" />

                <RadioButton x:Name="SortNameButton" GroupName="Sort" Style="{StaticResource IconToggle}"
                             Tag="Name" Content="&#x1F524;" ToolTip="이름순" Click="SortMode_Click" />
                <RadioButton x:Name="SortRecentButton" GroupName="Sort" Style="{StaticResource IconToggle}"
                             Tag="RecentLaunch" Content="&#x1F550;" ToolTip="최근 실행순" Click="SortMode_Click" />
                <RadioButton x:Name="SortCountButton" GroupName="Sort" Style="{StaticResource IconToggle}"
                             Tag="LaunchCount" Content="&#x1F4CA;" ToolTip="실행 빈도순" Click="SortMode_Click" />
                <RadioButton x:Name="SortSizeButton" GroupName="Sort" Style="{StaticResource IconToggle}"
                             Tag="Size" ToolTip="설치 용량순" Click="SortMode_Click">
                    <!-- 플로피 대신 하드디스크 모양: 본체 + 슬롯 + 표시등 -->
                    <Grid Width="16" Height="13">
                        <Border BorderBrush="{DynamicResource WindowForeground}" BorderThickness="1.5"
                                CornerRadius="2.5" />
                        <Rectangle Width="7" Height="1.5" Fill="{DynamicResource WindowForeground}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3.5,0,0" />
                        <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource WindowForeground}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2.5" />
                    </Grid>
                </RadioButton>

                <Button x:Name="SettingsButton" Style="{StaticResource ToolIconButton}"
                        Content="&#x2699;" ToolTip="설정" Click="SettingsButton_Click" />

            </StackPanel>
        </DockPanel>

    </Grid>
    </TabItem>

    <TabItem Header="DC 갤러리">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="16,16,16,0">
                <TextBlock Text="갤러리 관리" VerticalAlignment="Center" Margin="0,0,7,0"
                           FontSize="12" FontWeight="SemiBold" />
                <ComboBox x:Name="GallerySourceCombo" Width="300" Height="30"
                          Margin="0,0,6,0" DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          StaysOpenOnEdit="True"
                          TextSearch.TextPath="GalleryId"
                          VerticalContentAlignment="Center"
                          Foreground="{DynamicResource WindowForeground}"
                          Background="{DynamicResource ControlBackground}"
                          BorderBrush="{DynamicResource ControlBorder}"
                          ToolTip="등록된 갤러리를 고르거나 ID·주소를 직접 입력하세요"
                          SelectionChanged="GallerySourceSelection_Changed"
                          KeyDown="GallerySourceCombo_KeyDown" />
                <!-- 이전 코드 경로와의 호환용이며 화면에는 표시하지 않습니다. -->
                <ComboBox x:Name="GalleryKindCombo" Visibility="Collapsed" />
                <TextBox x:Name="GalleryIdBox" Visibility="Collapsed" />
                <Button Content="추가" Height="30" MinWidth="48" Margin="0,0,4,0"
                        Click="AddGalleryToAggregate_Click"
                        Foreground="{DynamicResource WindowForeground}"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        ToolTip="입력한 갤러리를 등록하고 통합 목록에 포함합니다" />
                <Button Content="삭제" Height="30" MinWidth="48" Margin="0,0,4,0"
                        Click="RemoveGalleryFromAggregate_Click"
                        Foreground="{DynamicResource WindowForeground}"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        ToolTip="현재 갤러리를 저장 목록에서 삭제합니다" />
                <Button Style="{StaticResource ToolIconButton}"
                        Content="&#x1F504;" Margin="0,0,8,0"
                        Click="RefreshAllGalleries_Click"
                        ToolTip="모든 갤러리 새로고침" />
                <RadioButton x:Name="GallerySortTimeButton" GroupName="GallerySort"
                             Style="{StaticResource IconToggle}"
                             Tag="Time" Content="&#x1F552;"
                             ToolTip="새글 순"
                             Click="GallerySortButton_Click" />
                <RadioButton x:Name="GallerySortRecommendButton" GroupName="GallerySort"
                             Style="{StaticResource IconToggle}"
                             Tag="RecommendationGrade" Content="&#x2B50;"
                             ToolTip="추천 등급순: 추천 수 ÷ 조회 수"
                             Click="GallerySortButton_Click" />
                <RadioButton x:Name="GallerySortViewsButton" GroupName="GallerySort"
                             Style="{StaticResource IconToggle}"
                             Tag="WeightedViews" Content="&#x1F4C8;"
                             ToolTip="조회 가중치순: 갤러리별 최고 조회수를 100%로 계산"
                             Click="GallerySortButton_Click" />

                <Rectangle Width="1" Height="18" Margin="5,0,6,0"
                           Fill="{DynamicResource Separator}" />

                <RadioButton x:Name="GalleryCardViewButton" GroupName="GalleryView"
                             Style="{StaticResource IconToggle}"
                             Tag="Cards" Content="&#x25A6;"
                             ToolTip="카드 보기"
                             Click="GalleryViewButton_Click" />
                <RadioButton x:Name="GalleryListViewButton" GroupName="GalleryView"
                             Style="{StaticResource IconToggle}"
                             Tag="List" Content="&#x2637;"
                             ToolTip="글 목록 보기"
                             Click="GalleryViewButton_Click" />

                <!-- 이전 설정 파일과의 호환을 위한 숨김 컨트롤입니다. 필터로 사용하지 않습니다. -->
                <TextBox x:Name="RecommendFilterBox" Visibility="Collapsed" />
            </WrapPanel>

            <DockPanel Grid.Row="2" Margin="16,8,16,16">
                <TextBlock x:Name="GalleryStatusText" DockPanel.Dock="Left"
                           FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                           Text="사진은 20~35초 간격으로 썸네일만 저장합니다" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,0">
                <ListBox x:Name="GalleryList"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="GalleryAggregateScroll_ScrollChanged"
                         MouseLeftButtonUp="GalleryList_MouseLeftButtonUp"
                         KeyDown="GalleryList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardRoot" Background="Transparent"
                                                BorderThickness="1" BorderBrush="Transparent"
                                                CornerRadius="7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background"
                                                        Value="{DynamicResource TileHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardRoot" Property="Background"
                                                        Value="{DynamicResource TileSelected}" />
                                                <Setter TargetName="CardRoot" Property="BorderBrush"
                                                        Value="{DynamicResource TileSelectedBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="214" Height="205" Margin="4"
                                    Padding="6" CornerRadius="6"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="108" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="4"
                                            Background="{DynamicResource TileHover}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="&#x1F5BC;" FontFamily="Segoe UI Emoji"
                                                           FontSize="24" Opacity="0.35"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding ImageStatusText}"
                                                           FontSize="10" Opacity="0.5"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Image Source="{Binding Image}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasImage,
                                                       Converter={StaticResource BoolToVisibility}}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,4,4" Padding="5,2"
                                                    CornerRadius="4" Background="#B0000000">
                                                <TextBlock Text="{Binding RecommendText}"
                                                           Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="4,0,0,4" Padding="5,2"
                                                    CornerRadius="4" Background="#B0000000">
                                                <TextBlock Text="{Binding GalleryName}"
                                                           Foreground="White" FontSize="10" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="1" Margin="1,7,1,0"
                                               Text="{Binding Title}"
                                               ToolTip="{Binding Title}"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="38" />
                                    <TextBlock Grid.Row="2" Margin="1,3,1,1"
                                               Text="{Binding MetaText}"
                                               FontSize="10" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Margin="1,1,1,0"
                                               Text="{Binding ScoreText}"
                                               FontSize="10" Opacity="0.72"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="GalleryRowList"
                         Visibility="Collapsed"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="GalleryAggregateScroll_ScrollChanged"
                         MouseLeftButtonUp="GalleryRowList_MouseLeftButtonUp"
                         KeyDown="GalleryRowList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowRoot"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowRoot" Property="Background"
                                                        Value="{DynamicResource TileHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowRoot" Property="Background"
                                                        Value="{DynamicResource TileSelected}" />
                                                <Setter TargetName="RowRoot" Property="BorderBrush"
                                                        Value="{DynamicResource TileSelectedBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="76" Margin="2,2" Padding="9,5"
                                    CornerRadius="6"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}"
                                               ToolTip="{Binding Title}"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="38"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding RowScoreText}"
                                               FontSize="10" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,8,0" />

                                    <Border Grid.RowSpan="2" Grid.Column="1"
                                            Margin="8,0,0,0" CornerRadius="4"
                                            Background="{DynamicResource TileHover}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="&#x1F5BC;"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="18" Opacity="0.28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Image}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasImage,
                                                       Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="GalleryEmptyText"
                           Visibility="Collapsed"
                           MouseLeftButtonDown="GalleryAggregateEmpty_MouseLeftButtonDown"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Opacity="0.5"
                           FontSize="12"
                           Text="표시할 글이 없습니다.&#x0a;추천 필터를 낮추거나 새로고침해 보세요." />

            </Grid>

            <Grid x:Name="GalleryBrowserHost"
                  Grid.RowSpan="3"
                  Visibility="Collapsed"
                  Background="{DynamicResource WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="6" Margin="0,0,0,5"
                        CornerRadius="6"
                        Background="{DynamicResource ControlBackground}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="← 글목록"
                                Height="28" MinWidth="74"
                                Margin="0,0,6,0"
                                Click="GalleryBrowserBack_Click"
                                Foreground="{DynamicResource WindowForeground}"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                ToolTip="DC 갤러리 통합 글목록으로 돌아갑니다" />
                        <TextBlock x:Name="GalleryBrowserAddress"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontSize="10" Opacity="0.5"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ToolIconButton}"
                                Content="&#x2197;"
                                Margin="0,0,2,0"
                                Click="GalleryBrowserOpenExternal_Click"
                                ToolTip="기본 브라우저에서 열기" />
                        <Button Grid.Column="3"
                                Style="{StaticResource ToolIconButton}"
                                Content="&#x1F504;"
                                Click="GalleryBrowserRefresh_Click"
                                ToolTip="페이지 새로고침" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="GalleryBrowser"
                                 NavigationStarting="GalleryBrowser_NavigationStarting"
                                 NavigationCompleted="GalleryBrowser_NavigationCompleted" />
                    <TextBlock x:Name="GalleryBrowserStatus"
                               Text="게시글을 불러오는 중…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12" Opacity="0.55"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </TabItem>
    </TabControl>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="20">
        <Button x:Name="TitleBarMinimizeButton"
                Style="{StaticResource TitleBarButton}"
                Content="&#x2212;"
                ToolTip="최소화"
                Click="TitleBarMinimize_Click" />
        <Button x:Name="TitleBarMaximizeButton"
                Style="{StaticResource TitleBarButton}"
                Content="&#x25A1;"
                ToolTip="최대화"
                Click="TitleBarMaximize_Click" />
        <Button Style="{StaticResource CloseTitleBarButton}"
                Content="&#x2715;"
                ToolTip="닫기"
                Click="TitleBarClose_Click" />
    </StackPanel>
    </Grid>
</Window>

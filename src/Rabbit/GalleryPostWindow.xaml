<Window x:Class="Rabbit.GalleryPostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="게시글 보기"
        Width="920" Height="720"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="PostTitleText"
                       FontSize="21" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PostMetaText"
                       Margin="0,7,0,0"
                       FontSize="12" Opacity="0.62"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PostScoreText"
                       Margin="0,3,0,0"
                       FontSize="12" Opacity="0.75" />
            <Border Height="1" Margin="0,14,0,0"
                    Background="{DynamicResource Separator}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource WindowForeground}" />
                </Style>
            </ScrollViewer.Resources>
            <StackPanel>
                <TextBlock x:Name="LoadingText"
                           Text="본문을 불러오는 중…"
                           Opacity="0.55" FontSize="12"
                           Margin="0,12,0,12" />
                <StackPanel x:Name="ContentPanel" />
                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           Foreground="#FFE0A030"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,10" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Left"
                       Text="Esc 키로 닫기"
                       FontSize="11" Opacity="0.45"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="닫기" Width="84" Height="30"
                    IsCancel="True"
                    Click="Close_Click"
                    Foreground="{DynamicResource WindowForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" />
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="Rabbit.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rabbit inside 설정" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <TextBlock Text="설정" FontSize="17" FontWeight="SemiBold" />

        <TextBlock Margin="0,16,0,4" Text="무료 게임 국가 코드" FontWeight="SemiBold" FontSize="13" />
        <TextBlock x:Name="CountryHint" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" LineHeight="17" />

        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="비우기" Width="64" Margin="8,0,0,0"
                    Click="Clear_Click" ToolTip="Windows 지역 설정을 따릅니다"
                    Foreground="{DynamicResource WindowForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" />
            <TextBox x:Name="CountryBox" MaxLength="2" Padding="6,4"
                     CharacterCasing="Upper" VerticalContentAlignment="Center"
                     Background="{DynamicResource ControlBackground}"
                     Foreground="{DynamicResource WindowForeground}"
                     BorderBrush="{DynamicResource ControlBorder}"
                     CaretBrush="{DynamicResource WindowForeground}" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="#FFE0A030" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="확인" Width="84" IsDefault="True" Click="Ok_Click"
                    Foreground="{DynamicResource WindowForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" />
            <Button Content="취소" Width="84" Margin="8,0,0,0" IsCancel="True"
                    Foreground="{DynamicResource WindowForeground}"
                    Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="Rabbit.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rabbit inside 정보" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="52" Height="52" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="rabbit inside" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="12" Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.85"
                   Text="바탕화면·탐색기·시작 메뉴에서 바로가기를 끌어다 놓아 모아 두고 실행하는 개인용 런처입니다. Windows 설정에 맞춰 다크·라이트 모드로 바뀝니다." />

        <TextBlock Margin="0,18,0,6" Text="단축키와 조작" FontWeight="SemiBold" FontSize="13" />
        <TextBlock x:Name="ShortcutsText" FontSize="12" Opacity="0.85" LineHeight="19" />

        <TextBlock Margin="0,18,0,6" Text="데이터 파일" FontWeight="SemiBold" FontSize="13" />
        <TextBlock x:Name="PathsText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="17" />

        <Button Content="닫기" Width="92" HorizontalAlignment="Right" Margin="0,20,0,0"
                IsDefault="True" IsCancel="True"
                Foreground="{DynamicResource WindowForeground}"
                Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource ControlBorder}" />
    </StackPanel>
</Window>

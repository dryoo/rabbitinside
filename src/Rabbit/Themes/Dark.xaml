<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 다크 모드 색입니다. 키 이름은 Light.xaml과 동일해야 합니다. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="WindowForeground" Color="#FFEDEDED" />

    <SolidColorBrush x:Key="TileHover" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TileSelected" Color="#44007ACC" />
    <SolidColorBrush x:Key="TileSelectedBorder" Color="#77007ACC" />

    <SolidColorBrush x:Key="Separator" Color="#22FFFFFF" />

    <SolidColorBrush x:Key="ControlBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ControlBorder" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="PopupBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="PopupBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#44007ACC" />
    <SolidColorBrush x:Key="ScrollTrack" Color="#FF252525" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#99FFFFFF" />

    <!-- 메뉴 항목 왼쪽의 아이콘 자리(GlyphPanel)는 WPF 기본 템플릿이 시스템 강조색을 씁니다.
         다크에서는 밝은 하늘색 띠로 보이므로 테마 색으로 덮어씁니다. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FF252525" />
</ResourceDictionary>
